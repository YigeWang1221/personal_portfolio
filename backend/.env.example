# portfolio-api environment (ADR-022, docs/AI_Chat/deployment-contract.md §4). No real values here.
# Copy it to backend/.env (git-ignored, mode 600) and fill that in. The stack's compose file loads backend/.env with
# env_file, so the container gets these variables and nothing from the stack's own .env.
# One VAR=value per line; keep comments on their own lines.

# Shared secret the Edge Worker sends as X-Origin-Key (the same value as the Worker secret ORIGIN_KEY).
PORTFOLIO_ORIGIN_KEY=

# Model plans, tried in order A → B → C (PROVIDER_ORDER). You choose every model. A plan with any empty value is
# skipped. The protocol follows the URL:
#   - https://generativelanguage.googleapis.com/v1beta  → Gemini API (give the base; the model goes in MODEL_PLAN_x)
#   - any other URL                                     → OpenAI-compatible; "/chat/completions" is added if missing
# Prefer non-reasoning models: the first visible text must arrive within 10 seconds, or the next plan is tried.

# plan A — for example this machine's Gemini gateway: http://<PROVIDER_A_SERVICE>:<PORT>/v1
API_URL_PLAN_A=
MODEL_PLAN_A=
KEY_PLAN_A=

# plan B
API_URL_PLAN_B=
MODEL_PLAN_B=
KEY_PLAN_B=

# plan C
API_URL_PLAN_C=
MODEL_PLAN_C=
KEY_PLAN_C=

# Order and limits (defaults shown).
# PROVIDER_ORDER=A,B,C
DAILY_REQUEST_CAP=100
# RATE_PER_MINUTE=6
# RATE_PER_HOUR=30
# MAX_CONCURRENT=3
# MAX_OUTPUT_TOKENS=600
# Off-topic misuse: this many refusals within the window block the visitor for GUARD_BLOCK_MS.
# GUARD_STRIKE_LIMIT=3
# GUARD_STRIKE_WINDOW_MS=600000
# GUARD_BLOCK_MS=600000

# Local development without any model: PROVIDER_MODE=mock
