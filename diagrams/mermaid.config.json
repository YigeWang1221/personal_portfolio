{
  "theme": "base",
  "htmlLabels": false,
  "themeVariables": {
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#f2f5f1",
    "primaryBorderColor": "#21634b",
    "primaryTextColor": "#17251f",
    "secondaryColor": "#edf3ee",
    "secondaryBorderColor": "#21634b",
    "secondaryTextColor": "#17251f",
    "tertiaryColor": "#ffffff",
    "tertiaryBorderColor": "#c5d0c8",
    "tertiaryTextColor": "#17251f",
    "lineColor": "#526159",
    "textColor": "#17251f",
    "mainBkg": "#f2f5f1",
    "nodeBorder": "#21634b",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#c5d0c8",
    "titleColor": "#17251f",
    "edgeLabelBackground": "#fafaf7",
    "actorBkg": "#f2f5f1",
    "actorBorder": "#21634b",
    "actorTextColor": "#17251f",
    "actorLineColor": "#c5d0c8",
    "signalColor": "#2e3d36",
    "signalTextColor": "#17251f",
    "labelBoxBkgColor": "#edf3ee",
    "labelBoxBorderColor": "#21634b",
    "labelTextColor": "#17251f",
    "loopTextColor": "#17251f",
    "noteBkgColor": "#f5eddc",
    "noteBorderColor": "#8a6a2e",
    "noteTextColor": "#17251f",
    "activationBkgColor": "#edf3ee",
    "activationBorderColor": "#21634b",
    "sequenceNumberColor": "#ffffff"
