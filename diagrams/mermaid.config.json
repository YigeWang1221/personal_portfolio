{
  "theme": "base",
  "htmlLabels": false,
  "themeVariables": {
    "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#f1efe8",
    "primaryBorderColor": "#426a57",
    "primaryTextColor": "#1f201d",
    "secondaryColor": "#dce8e1",
    "secondaryBorderColor": "#426a57",
    "secondaryTextColor": "#1f201d",
    "tertiaryColor": "#ffffff",
    "tertiaryBorderColor": "#d6d2c7",
    "tertiaryTextColor": "#1f201d",
    "lineColor": "#6b6963",
    "textColor": "#1f201d",
    "mainBkg": "#f1efe8",
    "nodeBorder": "#426a57",
    "clusterBkg": "#ffffff",
    "clusterBorder": "#d6d2c7",
    "titleColor": "#1f201d",
    "edgeLabelBackground": "#f8f7f3",
    "actorBkg": "#f1efe8",
    "actorBorder": "#426a57",
    "actorTextColor": "#1f201d",
    "actorLineColor": "#d6d2c7",
    "signalColor": "#3f3e3a",
    "signalTextColor": "#1f201d",
    "labelBoxBkgColor": "#dce8e1",
    "labelBoxBorderColor": "#426a57",
    "labelTextColor": "#1f201d",
    "loopTextColor": "#1f201d",
    "noteBkgColor": "#f5eddc",
    "noteBorderColor": "#8a6a2e",
    "noteTextColor": "#1f201d",
    "activationBkgColor": "#dce8e1",
    "activationBorderColor": "#426a57",
    "sequenceNumberColor": "#ffffff"
  },
  "flowchart": {
    "htmlLabels": false,
    "curve": "basis",
    "padding": 12,
    "nodeSpacing": 40,
    "rankSpacing": 48
  },
  "sequence": {
    "mirrorActors": false,
    "showSequenceNumbers": false,
    "wrap": true,
    "width": 170,
    "actorMargin": 24,
    "boxMargin": 8,
    "messageMargin": 34,
    "messageFontSize": 15,
    "actorFontSize": 15,
    "noteFontSize": 14,
    "noteMargin": 8,
    "useMaxWidth": true
  },
  "class": {
    "htmlLabels": false
  }
}
