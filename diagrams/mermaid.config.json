    "mirrorActors": false,
    "showSequenceNumbers": false,
    "wrap": true,
    "width": 170,
    "actorMargin": 24,
    "boxMargin": 8,
    "messageMargin": 34,
    "messageFontSize": 15,
    "actorFontSize": 15,
    "noteFontSize": 14,
    "noteMargin": 8,
    "useMaxWidth": true
  },
  "class": {
    "htmlLabels": false
  }
