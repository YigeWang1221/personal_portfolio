---
import { localePath, type Locale } from '../lib/i18n';
import { getContent } from '../lib/content/load';
import type { TrackId } from '../lib/content/schema';

interface Props {
  ids: TrackId[];
  locale: Locale;
}
const { ids, locale } = Astro.props;
const { tracks } = getContent();
---

<span class="track-tags">
  {ids.map((id) => {
    const tr = tracks.find((x) => x.id === id)!;
    return (
      <a class={`track-${id}`} href={localePath(locale, `/tracks/${id}/`)}>
        {tr.title[locale]}
      </a>
    );
  })}
</span>
