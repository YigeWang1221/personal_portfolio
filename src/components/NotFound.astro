---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath, type Locale } from '../lib/i18n';
import { t } from '../lib/content/load';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<BaseLayout locale={locale} path="/" title={t(locale, 'notfound.title')} description={t(locale, 'notfound.body')} notFound>
  <div class="container">
    <section class="notfound">
      <p class="eyebrow">404</p>
      <h1>{t(locale, 'notfound.title')}</h1>
      <p>{t(locale, 'notfound.body')}</p>
      <ul>
        <li><a href={localePath(locale, '/')}>{t(locale, 'nav.home')}</a></li>
        <li><a href={localePath(locale, '/projects/')}>{t(locale, 'nav.projects')}</a></li>
        <li><a href={localePath(locale, '/background/')}>{t(locale, 'nav.background')}</a></li>
        <li><a href={localePath(locale, '/resume/')}>{t(locale, 'nav.resume')}</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
