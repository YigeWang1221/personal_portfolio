---
// A card's flow schematic: the implemented path in three to five stages, as real text instead of a shrunken
// diagram. Labeled CURRENT / PROPOSED like any diagram (ADR-008); configuration details stay on the case study.
import type { Locale } from '../lib/i18n';
import type { ProjectMeta } from '../lib/content/schema';
import { t, termText } from '../lib/content/load';

interface Props {
  steps: NonNullable<NonNullable<ProjectMeta['card']>['steps']>;
  locale: Locale;
  label: string;
}
const { steps, locale, label } = Astro.props;
---

<figure class="card-figure card-flow">
  <ol aria-label={label}>
    {steps.items.map((s) => (
      <li>
        <span class="flow-title">{s.title[locale]}</span>
        {s.detail && <span class="flow-detail">{termText(s.detail, locale)}</span>}
      </li>
    ))}
  </ol>
  <figcaption>
    <span class={`asset-label label-${steps.label}`} title={t(locale, `labels.${steps.label}`)}>{steps.label}</span>
    {steps.note && <span>{steps.note[locale]}</span>}
  </figcaption>
</figure>
