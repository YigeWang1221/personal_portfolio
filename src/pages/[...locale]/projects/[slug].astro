---
// Case study page (ADR-017). First screen: what it is, one status line, one statement of my role, the period
// and context, the outside links, then the lead visual (product screens, a key chart or an architecture
// preview) and the few facts worth remembering. Then the project's own story with an "On this page"
// navigation, the deep dive, the full stack, one related case study and the way back to the catalog.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StatusBadge from '../../../components/StatusBadge.astro';
import StackChips from '../../../components/StackChips.astro';
import FactList from '../../../components/FactList.astro';
import FigureView from '../../../components/FigureView.astro';
import RoadmapView from '../../../components/RoadmapView.astro';
import ProjectLinks from '../../../components/ProjectLinks.astro';
import { LOCALES, localeParam, localePath, type Locale } from '../../../lib/i18n';
import { getContent, t, type Project } from '../../../lib/content/load';
import { formatPeriod } from '../../../lib/format';

export function getStaticPaths() {
  const { projects } = getContent();
  return LOCALES.flatMap((locale) =>
    [...projects.values()].map((project) => ({
      params: { locale: localeParam(locale), slug: project.meta.slug },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { projects, focus } = getContent();
const m = project.meta;
const path = `/projects/${m.slug}/`;
const sections = project.sections[locale];
const highlights = m.highlights.map((key) => m.facts[key]);
const lead = m.lead ? project.figures.find((f) => f.id === m.lead) : undefined;
const figuresFor = (sectionId: string) => project.figures.filter((f) => f.section === sectionId && f.id !== m.lead);
const related = m.related ? projects.get(m.related) : undefined;
const aliasesFor = (sectionId: string) =>
  Object.entries(m.anchor_aliases).filter(([, target]) => target === sectionId).map(([alias]) => alias);
const focusTitles = project.focusIds.map((id) => focus.find((f) => f.id === id)!.title[locale]);
---

<BaseLayout locale={locale} path={path} title={m.title[locale]} description={m.summary[locale]} nav="projects">
  <div class="container">
    <nav class="breadcrumb" aria-label={t(locale, 'nav.breadcrumb')}>
      <ol>
        <li><a href={localePath(locale, '/projects/')}>{t(locale, 'nav.projects')}</a></li>
        <li aria-current="page">{m.title[locale]}</li>
      </ol>
    </nav>

    <header class="project-head">
      <h1>{m.title[locale]}</h1>
      <p class="subtitle">{m.subtitle[locale]}</p>
      <p class="status-line">
        <StatusBadge status={m.status} team={m.team} locale={locale} />
        {m.status_note && <span class="status-note">{m.status_note[locale]}</span>}
      </p>
      <p class="project-role"><span class="role-label">{t(locale, 'project.role')}</span> {m.role[locale]}</p>
      <p class="project-meta">
        <span>{formatPeriod(m.period, locale)}</span>
        <span>{m.context[locale]}</span>
        <span>{focusTitles.join(' · ')}</span>
      </p>
      {m.links.length > 0 && <ProjectLinks links={m.links} locale={locale} buttons />}
    </header>

    {lead && (
      <div class="project-lead">
        <FigureView figure={lead} locale={locale} lead />
      </div>
    )}

    {highlights.length > 0 && (
      <section class="key-facts" aria-labelledby="facts-title">
        <h2 id="facts-title" class="section-label">{t(locale, 'project.facts')}</h2>
        <FactList facts={highlights} locale={locale} />
      </section>
    )}

    <details class="toc-mobile">
      <summary>{t(locale, 'project.contents')}</summary>
      <ol>
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      </ol>
    </details>

    <div class="project-body">
      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title">{t(locale, 'project.contents')}</h2>
        <ol>
          {sections.map((s) => (
            <>
              {m.deep_dive_from === s.id && <li class="toc-divider" aria-hidden="true">{t(locale, 'project.deep_dive')}</li>}
              <li><a href={`#${s.id}`}>{s.title}</a></li>
            </>
          ))}
        </ol>
      </nav>

      <div class="narrative">
        {sections.map((s) => (
          <>
            {m.deep_dive_from === s.id && (
              <div class="layer-divider" role="separator">
                <p>{t(locale, 'project.deep_dive')}</p>
              </div>
            )}
            <section id={s.id} aria-labelledby={`${s.id}-title`}>
              {aliasesFor(s.id).map((alias) => <span id={alias} class="anchor-alias"></span>)}
              <h2 id={`${s.id}-title`}>{s.title}</h2>
              <div class="prose" set:html={s.html} />
              {m.roadmap && m.roadmap.section === s.id && (
                <div class="figure">
                  <h3>{m.roadmap.title[locale]}</h3>
                  <RoadmapView roadmap={m.roadmap} locale={locale} />
                </div>
              )}
              {figuresFor(s.id).map((f) => <FigureView figure={f} locale={locale} />)}
            </section>
          </>
        ))}

        <section class="stack-block" aria-labelledby="stack-title">
          <h2 id="stack-title" class="section-label">{t(locale, 'project.stack')}</h2>
          <StackChips items={m.stack} label={t(locale, 'project.stack')} />
        </section>
      </div>
    </div>

    <nav class="case-foot" aria-label={t(locale, 'project.related')}>
      {related && (
        <p class="related">
          <span class="section-label">{t(locale, 'project.related')}</span>
          <a href={localePath(locale, `/projects/${related.meta.slug}/`)}>{related.meta.title[locale]}</a>
          <span class="muted">{related.meta.subtitle[locale]}</span>
        </p>
      )}
      <p><a href={localePath(locale, '/projects/')}><span aria-hidden="true">← </span>{t(locale, 'project.all_projects')}</a></p>
    </nav>
  </div>
</BaseLayout>
