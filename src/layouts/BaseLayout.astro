---
// Every page renders through this layout: <html lang>, CSP, canonical/hreflang, robots, header, footer.
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { NavKey } from '../components/SiteHeader.astro';
import { HTML_LANG, OG_LOCALE, absoluteUrl, otherLocale, type Locale } from '../lib/i18n';
import { siteConfig } from '../lib/site-config.mjs';
import { readFileSync } from 'node:fs';
import { createHash } from 'node:crypto';
import { t } from '../lib/content/load';

interface Props {
  locale: Locale;
  /** Language-neutral path of this page, e.g. "/projects/kk-knock/". */
  path: string;
  title: string;
  description: string;
  /** Section of the header navigation to mark as current. */
  nav?: NavKey;
  /** 404 pages are never indexed and have no canonical URL. */
  notFound?: boolean;
}

const { locale, path, title, description, nav, notFound = false } = Astro.props;

// Same policy as the KK introduction page; also sent as a header via public/_headers (with frame-ancestors).
const CSP =
  "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; " +
  "connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'";

const canonical = notFound ? null : absoluteUrl(locale, path);
const alternates = notFound
  ? []
  : ([
      ['en', absoluteUrl('en', path)],
      ['zh-CN', absoluteUrl('zh', path)],
      ['x-default', absoluteUrl('en', path)],
    ].filter(([, href]) => href) as [string, string][]);
const indexable = siteConfig.indexable && !notFound;
// The script is served from public/ without a content hash; a version query makes each release fetch it anew.
const scriptVersion = createHash('sha256').update(readFileSync('public/js/site.js')).digest('hex').slice(0, 10);
const fullTitle = path === '/' ? title : `${title} · ${t(locale, 'site.name')}`;
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={CSP} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map(([lang, href]) => <link rel="alternate" hreflang={lang} href={href} />)}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLocale(locale)]} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/SourceSerif4-Semibold.ttf" as="font" type="font/ttf" crossorigin />
    {/* Progressive enhancement only (ADR-016): the mobile menu and the project filter. Every page works without it.
        is:inline keeps Astro from bundling it; the file is served as is from public/. */}
    <script is:inline src={`/js/site.js?v=${scriptVersion}`} defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
    <SiteHeader locale={locale} path={path} current={nav} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>
