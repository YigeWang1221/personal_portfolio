%% CURRENT — the objects on the donation path, from the model/ package of the team repository (INFO 5100, Mar–Apr 2025).
classDiagram
  direction LR
  class NetWork {
    WorkQueue checkList
    WorkQueue warehouseList
    EnterPriseDirctory enterprises
    UserAccountDirctory accounts
  }
  class BasicOrganization {
    <<abstract>>
    WorkQueue workQueue
    UserAccountDirctory accounts
    getSupportedRole()
  }
  class BasicEnterprise {
    <<abstract>>
    BasicEnterpriseType type
    OrganizationDirctory organizations
  }
  class UserAccount {
    BasicRole role
    WorkQueue workQueue
  }
  class BasicRole {
    <<abstract>>
    createWorkArea()
  }
  class Deliver {
    WorkQueue doingWorkQueue
    WorkQueue finishedWorkQueue
    updateStatus()
  }
  class WorkRequest {
    BasicOrganization sender
    BasicOrganization receiver
    String status
  }
  class WorkRequestFoodItem
  class WorkRequestDelivery {
    String taskStatus
    UserAccount deliver
  }
  class WorkRequestNeeds
  BasicOrganization <|-- BasicEnterprise
  NetWork "1" --> "*" BasicEnterprise
  BasicEnterprise "1" --> "*" BasicOrganization
  BasicOrganization "1" --> "*" UserAccount
  UserAccount --> BasicRole
