# Environment variables of the portfolio repository (ADR-015, ADR-022). Placeholders only; never commit real values.
#
# 0) AI backend (portfolio-api): NOT in this file. Its settings (PORTFOLIO_ORIGIN_KEY and the three model plans
#    API_URL_PLAN_x / MODEL_PLAN_x / KEY_PLAN_x) live in backend/.env (git-ignored; template backend/.env.example).
#    The Mac mini stack loads that file into the container; the stack's own .env is not used for it.


# 1) Build switches -----------------------------------------------------------------------------------------------
# The build reads them from the shell, so pass them on the command line, for example:
#   PUBLIC_CHAT_ENABLED=true npm run build
#   SITE_URL=https://<custom domain> SITE_INDEXING=true npm run build

# Public origin of the site, https only, no path. Empty: no canonical URLs, and the site stays noindex.
SITE_URL=
# "true" lets search engines index the site. Only allowed together with SITE_URL.
SITE_INDEXING=
# "true" renders the AI assistant (chat window, /js/chat.js, /css/chat.css). Empty: the site is built without it.
PUBLIC_CHAT_ENABLED=


# 2) Edge Worker secrets (edge/api-proxy.ts) ----------------------------------------------------------------------
# Production: set each one with  npx wrangler secret put <NAME>  (they then live only in Cloudflare).
# Local `wrangler dev`: copy these lines into .dev.vars (git-ignored), or pass them with --var.
# Two values are needed. Until both are set, /api/* answers 503 and the rest of the site is unaffected.

# https:// + the tunnel hostname you add for portfolio-api in Cloudflare (Networks → Tunnels → Public hostname),
# for example https://portfolio-api.<your domain>. An address, not a secret.
ORIGIN_URL=
# Must equal PORTFOLIO_ORIGIN_KEY in backend/.env.
ORIGIN_KEY=
# Optional, only if the tunnel hostname is put behind Cloudflare Access with a service token:
# ACCESS_CLIENT_ID=
# ACCESS_CLIENT_SECRET=
# Optional, a Worker variable rather than a secret: extra origins allowed to POST, comma-separated.
# ALLOWED_ORIGINS=http://localhost:4321
